; =======================================================
; 🇨🇳 Mainland China Direct
; =======================================================

; Custom Mainland China Domain
ruleset=🇨🇳 China Direct,[]DOMAIN-SUFFIX,pomo.mom

; Mainland China Domains
ruleset=🇨🇳 China Direct,https://raw.githubusercontent.com/hooleeas/ACL4SSR/master/Clash/ChinaDomain.list

; Mainland China Company IPs
ruleset=🇨🇳 China Direct,https://raw.githubusercontent.com/hooleeas/ACL4SSR/master/Clash/ChinaCompanyIp.list

; Mainland China IPs
ruleset=🇨🇳 China Direct,[]GEOIP,CN


; =======================================================
; 🆎 Advertisement Blocking
; =======================================================

; General Web Advertisements
ruleset=🆎 Ad Block,https://raw.githubusercontent.com/hooleeas/ACL4SSR/master/Clash/BanAD.list

; App / Software / Splash Screen Advertisements
ruleset=🆎 Ad Block,https://raw.githubusercontent.com/hooleeas/ACL4SSR/master/Clash/BanProgramAD.list

; EasyList General Advertisements
ruleset=🆎 Ad Block,https://raw.githubusercontent.com/hooleeas/ACL4SSR/master/Clash/BanEasyList.list

; EasyList China Advertisements
ruleset=🆎 Ad Block,https://raw.githubusercontent.com/hooleeas/ACL4SSR/master/Clash/BanEasyListChina.list


; =======================================================
; 🛟 Fallback
; =======================================================

; All unmatched traffic goes to the fallback policy
ruleset=🛟 Fallback,[]FINAL


; =======================================================
; 🚀 Node Select
;
; Manual node selection only
; No automatic selection
; No URLTest
; =======================================================

custom_proxy_group=🚀 Node Select`select`.*


; =======================================================
; 🇨🇳 China Direct
;
; Force DIRECT
; =======================================================

custom_proxy_group=🇨🇳 China Direct`select`[]DIRECT


; =======================================================
; 🆎 Ad Block
;
; Force REJECT
; =======================================================

custom_proxy_group=🆎 Ad Block`select`[]REJECT


; =======================================================
; 🛟 Fallback
;
; DIRECT / Manual Node Selection
; =======================================================

custom_proxy_group=🛟 Fallback`select`[]DIRECT`[]🚀 Node Select


; =======================================================
; Converter Control
; =======================================================

enable_rule_generator=true
overwrite_original_rules=true
