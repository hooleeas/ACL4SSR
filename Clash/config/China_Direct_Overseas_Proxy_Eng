[custom]

; =======================================================
; CF-SUB Minimal Routing Configuration
;
; Routing Logic:
; 1. Overseas Services → 🚀 Node Select
; 2. Mainland China → 🇨🇳 China Direct
; 3. Advertisements → 🆎 Ad Block
; 4. Unmatched Traffic → 🛟 Fallback
;
; Node Testing:
; Automatic URLTest is disabled.
; Use the ⚡ manual latency test provided by the client.
;
; Compatible with:
; Clash / Clash Meta / Mihomo / sing-box
;
; Not Used:
; process_name
; process_path
; url-test
; =======================================================


; =======================================================
; 🌍 Overseas Services / Proxy Rules
; =======================================================

; Telegram
ruleset=🚀 Node Select,https://raw.githubusercontent.com/hooleeas/ACL4SSR/master/Clash/Telegram.list

; Overseas Proxy Rules
ruleset=🚀 Node Select,https://raw.githubusercontent.com/hooleeas/ACL4SSR/master/Clash/ProxyGFWlist.list

; Lightweight Overseas Proxy Rules
ruleset=🚀 Node Select,https://raw.githubusercontent.com/hooleeas/ACL4SSR/master/Clash/ProxyLite.list


; =======================================================
; 🤖 AI Services
; =======================================================

ruleset=🚀 Node Select,https://raw.githubusercontent.com/hooleeas/ACL4SSR/master/Clash/Ruleset/AI.list

ruleset=🚀 Node Select,https://raw.githubusercontent.com/hooleeas/ACL4SSR/master/Clash/Ruleset/OpenAi.list


